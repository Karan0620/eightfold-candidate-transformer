{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",

  "properties": {

    "candidate_id": {
      "type": "string"
    },

    "full_name": {
      "type": "string"
    },

    "emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "phones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": ["string", "null"] },
          "company": { "type": ["string", "null"] },
          "duration": { "type": ["string", "null"] },
          "location": { "type": ["string", "null"] }
        }
      }
    },

    "education": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "overall_confidence": {
      "type": "number"
    },

    "provenance": {
      "type": "object"
    }

  },

  "required": [
    "candidate_id",
    "full_name",
    "emails",
    "phones",
    "skills"
  ]
}